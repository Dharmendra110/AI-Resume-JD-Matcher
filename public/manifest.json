{
  "manifest_version": 3,
  "name": "Resume JD Matcher",
  "version": "1.0.0",
  "description": "Compare Resume with LinkedIn Job Description",

  "action": {
    "default_popup": "index.html",
    "default_title": "Resume Matcher"
  },

  "background": {
    "service_worker": "background.js"
  },

  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],

  "host_permissions": [
    "http://localhost:9000/*",
    "https://www.linkedin.com/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/jobs/*"
      ],
      "js": [
        "content.js"
      ]
    }
  ]
}